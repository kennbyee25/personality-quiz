{
  "name": "personality-quiz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "ci": "npm-run-all --parallel lint typecheck test knip",
    "knip": "knip",
    "test": "vitest run",
    "test:ui": "vitest"
  },
  "knip": {
    "ignore": [
      "src/quiz/types.ts"
    ],
    "ignoreDependencies": [
      "prettier",
      "autoprefixer"
    ],
    "$schema": "https://unpkg.com/knip@6/schema.json"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@opentelemetry/api": "^1.0.0",
    "@opentelemetry/sdk-node": "^1.0.0",
    "@opentelemetry/instrumentation-http": "^1.0.0",
    "@opentelemetry/instrumentation-express": "^1.0.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^1.0.0",
    "@opentelemetry/sdk-metrics": "^1.0.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.4.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "eslint-plugin-unicorn": "^56.0.1",
    "globals": "^15.0.0",
    "jsdom": "^29.1.1",
    "knip": "^6.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^5.2.0",
    "vitest": "^1.3.1"
  }
}
